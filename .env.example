# GHCR image published by .github/workflows/docker-publish.yml
APORIA_IMAGE=ghcr.io/kinanqazan/aporia

# Optional MCP endpoint. Keep the bearer key private and at least 32 characters.
APORIA_MCP_ENABLED=false
APORIA_MCP_TOKEN=
# Comma-separated exact base origins clients use to reach this Aporia instance.
# Example: http://aporia:3000,https://notes.example.com
APORIA_MCP_ALLOWED_ORIGINS=
